{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Mocha Tests",
      "program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
      "args": [
        "-r",
        "ts-node/register",

        "${workspaceFolder}/src/**/*.spec.ts"
      ],
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Mocha Current File",
      "cwd": "${workspaceRoot}",
      "program": "${workspaceRoot}/node_modules/mocha/bin/mocha",
      "args": [
        "--config",
        "${workspaceFolder}/.mocharc.json",
        "--timeout",
        "999999",
        "--colors",
        "--recursive",
        "${file}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "protocol": "inspector"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Cucumber Test All",
      "program": "${workspaceFolder}/node_modules/cucumber/bin/cucumber-js",
      "args": [
        "-p",
        "default"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "protocol": "inspector"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Cucumber Test Tags Only",
      "program": "${workspaceFolder}/node_modules/cucumber/bin/cucumber-js",
      "args": [
        "-p",
        "default",
        "--tags",
        "@ONLY_RUN"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "protocol": "inspector"
    }
  ]
}
