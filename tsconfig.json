{
  "compilerOptions": {
    "outDir": "./dist/src",

    "target": "es6",
    "module": "commonjs",
    "lib": [
      "es2019"
    ],
    "moduleResolution": "node",
    "strict": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "resolveJsonModule": true,
    "types": [
      "node", // Added to allow the use of nodes fs
    ],
    "sourceMap": true
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "e2e",
    "test",
    "newman",
    "playground"
  ]
}
